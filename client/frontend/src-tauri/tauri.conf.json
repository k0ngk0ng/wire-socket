{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WireSocket",
  "version": "0.10.4",
  "identifier": "com.wiresocket.client",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WireSocket VPN",
        "width": 880,
        "height": 620,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "WireGuard over WebSocket VPN client",
    "longDescription": "Cross-platform VPN client with WireGuard over WebSocket tunneling",
    "resources": {
      "../../assets/tray-icon.png": "assets/tray-icon.png",
      "../../assets/tray-icon-mac.png": "assets/tray-icon-mac.png",
      "../../assets/icon-1024.png": "assets/icon-1024.png"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libappindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "wiresocket"
        ]
      }
    }
  }
}
